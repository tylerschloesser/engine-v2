{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(cargo *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": ["Bash(pnpm publish *)", "Bash(cargo publish *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
