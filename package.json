{
  "name": "engine-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "gc": "node scripts/gc.mjs",
    "gate": "node scripts/gate.mjs",
    "handoff": "node scripts/handoff.mjs",
    "test:slow": "node scripts/test.mjs --tier slow",
    "lint": "node scripts/lint.mjs",
    "setup:tools": "node scripts/setup-tools.mjs",
    "device:serve": "node packages/engine/scripts/device-serve.mjs",
    "format": "pnpm exec biome check --write . && cargo fmt",
    "golden": "pnpm --silent --filter engine build && node --disable-warning=ExperimentalWarning packages/engine/scripts/golden.mjs",
    "golden:bytes": "node scripts/golden-bytes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
