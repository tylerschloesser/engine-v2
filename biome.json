{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!spikes", "!docs", "!**/src/bindings"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/engine/src/**",
        "!packages/engine/src/clock.ts",
        "!packages/engine/src/test/**",
        "!packages/engine/src/vite.ts",
        "!packages/engine/src/build-game.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "ambient time: take a Clock (docs/decisions/0020 §8, src/clock.ts)",
                  "performance": "ambient time: take a Clock (docs/decisions/0020 §8, src/clock.ts)",
                  "setTimeout": "ambient time: take a Scheduler (docs/decisions/0020 §8, src/clock.ts)",
                  "setInterval": "ambient time: take a Scheduler (docs/decisions/0020 §8, src/clock.ts)",
                  "requestAnimationFrame": "ambient time: take a Scheduler (docs/decisions/0020 §8, src/clock.ts)"
                }
              }
            }
          }
        }
      }
    }
  ]
}
